<html>
  <head>
    {% include ('v2/Modules/head.twig') %}
    <style>
        .form-group {
            margin-bottom: 15px;
        }
    </style>
  </head>
  <body>
    <div id="app">
      {% include ('v2/Modules/nav.twig') %}
      <div class="container mt-3">
		<h3>Client deployer</h3>
		<form role="form" method="POST" action="" id="dynamic-form" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ data.csrf_token }}">
            <div class="form-group row">
                <label for="application" class="col-form-label text-md-right" style="margin-left:15px;">Application <em>(eg. 0.1.1pcapplication)</em></label>
                <div class="col-md-12">
                    <input type="text" name="application" value="{{ data.application }}" placeholder="Application version" autofocus="autofocus" class="form-control" required>
                </div>
            </div>
            <div class="form-group row">
                <label for="md5" class="col-form-label text-md-right" style="margin-left:15px;">MD5 hash <em>(eg. 4a9f5eb327067fa82ed312029ecb7824)</em></label>
                <div class="col-md-12">
                    <input type="text" name="md5" value="{{ data.md5 }}" placeholder="MD5 hash" autofocus="autofocus" class="form-control" required>
                </div>
            </div>
            
            <div class="form-group" style="margin-top:40px;">
                <button type="submit" class="btn btn-success full-width">change</button>
            </div>
        </form>

        <form role="form" method="POST" action="" id="dynamic-form" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ data.csrf_token }}">
            <div class="form-group row">
                <label for="version" class="col-form-label text-md-right" style="margin-left:15px;">Version <em>(eg. version-69d48314c23a4510)</em></label>
                <div class="col-md-12">
                    <input type="text" name="version" value="{{ data.version }}" placeholder="Version" autofocus="autofocus" class="form-control" required>
                </div>
            </div>
            <div class="form-group row d-flex justify-content-center">
                <label for="libraries" class="col-form-label text-md-right">Libraries</label>
                <div class="col-md-3">
                    <input type="file" name="libraries" value="" class="form-control">
                </div>
                <label for="librariesqt4" class="col-form-label text-md-right">LibrariesQT4</label>
                <div class="col-md-3">
                    <input type="file" name="librariesqt4" value="" class="form-control">
                </div>
                <label for="executable" class="col-form-label text-md-right">Executable</label>
                <div class="col-md-3">
                    <input type="file" name="executable" value="" class="form-control">
                </div>
            </div>
            <div class="form-group row d-flex justify-content-center">
                <label for="redist" class="col-form-label text-md-right">Redist</label>
                <div class="col-md-3">
                    <input type="file" name="redist" value="" class="form-control">
                </div>
                <label for="content" class="col-form-label text-md-right">Content</label>
                <div class="col-md-3">
                    <input type="file" name="content" value="" class="form-control">
                </div>
                <label for="contenttextures3" class="col-form-label text-md-right">Content-textures3</label>
                <div class="col-md-3">
                    <input type="file" name="contenttextures3" value="" class="form-control">
                </div>
            </div>
            <div class="form-group row d-flex justify-content-center">
                <label for="contentterrain" class="col-form-label text-md-right">Content-terrain</label>
                <div class="col-md-3">
                    <input type="file" name="contentterrain" value="" class="form-control">
                </div>
                <label for="shaders" class="col-form-label text-md-right">Shaders</label>
                <div class="col-md-3">
                    <input type="file" name="shaders" value="" class="form-control">
                </div>
                <label for="builtinplugins" class="col-form-label text-md-right">BuiltInPlugins</label>
                <div class="col-md-3">
                    <input type="file" name="builtinplugins" value="" class="form-control">
                </div>
            </div>
            <div class="form-group row d-flex justify-content-center">
                <label for="publiclauncher" class="col-form-label text-md-right" style="margin-left:15px;">PublicLauncher</label>
                <div class="col-md-3">
                    <input type="file" name="publiclauncher" value="" class="form-control">
                </div>
            </div>
            <div class="form-group" style="margin-top:40px;">
                <button type="submit" class="btn btn-success full-width">deploy</button>
            </div>
        </form>
	  </div>
    </div>
    {% include ('v2/Modules/footer.twig') %}
  </body>
</html>